;;; themes/caelus-theme.el -*- lexical-binding: t; -*-

;;; caelus-theme.el --- Warm cream on near-black, orange accent -*- lexical-binding: t; -*-

;;; Code:

(deftheme caelus
  "Warm cream on near-black with a saturated orange accent."
  :background-mode 'dark
  :kind 'color-scheme)

(let ((bg "#0f0f0f")
      (gray0 "#141514")   ; sunken: status/tab bars
      (gray1 "#1e1f1e")   ; raised: popups, cursor line
      (gray2 "#272a28")   ; hover, selected rows
      (gray3 "#3b403c")   ; selection, borders
      (gray4 "#585f5b")   ; inactive borders, line numbers
      (gray5 "#6c756f")   ; disabled text
      (gray6 "#888e7b")   ; comments, muted text
      (gray7 "#9a9c8b")   ; secondary text
      (gray8 "#b6b69a")   ; operators, punctuation
      (gray9 "#d9cdb5")   ; dimmed foreground
      (fg "#f4decd")
      (orange "#ef934d") (orange-light "#f4b585")
      (yellow "#efbf71")
      (red "#f16e65") (red-light "#ef968f")
      (green "#72ca68") (green-light "#98d694")
      (cyan "#7ec9a3") (cyan-light "#abd4bf")
      (blue "#71b4d6") (blue-light "#b0d4e8")
      (magenta "#e28dc6") (magenta-light "#ebadd6")
      (green-tint "#1e2b1c") (red-tint "#311d1c")
      (blue-tint "#1e282d") (orange-tint "#312318")
      (diff-text "#283841"))

  (apply
   #'custom-theme-set-faces 'caelus

   ;; The terminal paints its own background (like nvim's transparent
   ;; Normal); the GUI needs a solid one.
   `(default ((((type tty)) :foreground ,fg)
              (t :foreground ,fg :background ,bg)))

   ;; Everything else looks the same in GUI and terminal.
   (mapcar
    (lambda (spec) `(,(car spec) ((t ,@(cdr spec)))))
    `(
      ;; Editor ---------------------------------------------------------------
      (cursor :background ,orange)
      (fringe :background unspecified)
      (region :background ,gray3 :extend t)
      (secondary-selection :background ,gray2 :extend t)
      (hl-line :background ,gray1 :extend t)
      (highlight :background ,gray2)
      (shadow :foreground ,gray6)
      (line-number :foreground ,gray4)
      (line-number-current-line :foreground ,orange :weight bold)
      (vertical-border :foreground ,gray3)
      (window-divider :foreground ,gray3)
      (window-divider-first-pixel :foreground ,gray3)
      (window-divider-last-pixel :foreground ,gray3)
      (fill-column-indicator :foreground ,gray2)
      (trailing-whitespace :background ,red-tint)
      (whitespace-space :foreground ,gray3)
      (whitespace-tab :foreground ,gray3)
      (whitespace-newline :foreground ,gray3)
      (escape-glyph :foreground ,orange-light)
      (homoglyph :foreground ,orange-light)
      (nobreak-space :foreground ,gray4 :underline t)
      (minibuffer-prompt :foreground ,orange :weight bold)
      (link :foreground ,blue :underline t)
      (link-visited :foreground ,magenta :underline t)
      (button :foreground ,blue :underline t)
      (tooltip :foreground ,fg :background ,gray1)
      (error :foreground ,red :weight bold)
      (warning :foreground ,yellow)
      (success :foreground ,green)
      (show-paren-match :foreground ,orange :background ,gray2 :weight bold)
      (show-paren-mismatch :foreground ,bg :background ,red :weight bold)
      (header-line :foreground ,gray9 :background ,gray0)
      (help-key-binding :foreground ,orange :background ,gray1 :box (:line-width -1 :color ,gray3))

      ;; Search ---------------------------------------------------------------
      (isearch :foreground ,bg :background ,orange :weight bold)
      (isearch-fail :foreground ,red :background ,red-tint)
      (lazy-highlight :foreground ,bg :background ,yellow)
      (match :foreground ,bg :background ,yellow)
      (query-replace :foreground ,bg :background ,red)

      ;; Mode line and tabs ---------------------------------------------------
      (mode-line :foreground ,gray9 :background ,gray0 :box (:line-width 4 :color ,gray0))
      (mode-line-active :inherit mode-line)
      (mode-line-inactive :foreground ,gray5 :background ,gray0 :box (:line-width 4 :color ,gray0))
      (mode-line-buffer-id :foreground ,fg :weight bold)
      (mode-line-emphasis :foreground ,orange :weight bold)
      (mode-line-highlight :foreground ,orange :box nil)
      (tab-bar :foreground ,gray7 :background ,gray0)
      (tab-bar-tab :foreground ,bg :background ,orange :weight bold :box (:line-width 4 :color ,orange))
      (tab-bar-tab-inactive :foreground ,gray7 :background ,gray0 :box (:line-width 4 :color ,gray0))
      (tab-line :foreground ,gray7 :background ,gray0)
      (tab-line-tab-current :foreground ,bg :background ,orange :weight bold)
      (tab-line-tab-inactive :foreground ,gray7 :background ,gray0)

      ;; Syntax (font-lock; tree-sitter modes use the same faces) -------------
      (font-lock-comment-face :foreground ,gray6 :slant italic)
      (font-lock-comment-delimiter-face :inherit font-lock-comment-face)
      (font-lock-doc-face :foreground ,gray7 :slant italic)
      (font-lock-doc-markup-face :foreground ,orange-light)
      (font-lock-string-face :foreground ,green)
      (font-lock-keyword-face :foreground ,orange)
      (font-lock-builtin-face :foreground ,yellow :slant italic)
      (font-lock-function-name-face :foreground ,yellow)
      (font-lock-function-call-face :foreground ,yellow)
      (font-lock-variable-name-face :foreground ,fg)
      (font-lock-variable-use-face :foreground ,fg)
      (font-lock-property-name-face :foreground ,blue-light)
      (font-lock-property-use-face :foreground ,blue-light)
      (font-lock-type-face :foreground ,cyan)
      (font-lock-constant-face :foreground ,magenta)
      (font-lock-number-face :foreground ,magenta)
      (font-lock-preprocessor-face :foreground ,orange-light)
      (font-lock-escape-face :foreground ,orange-light)
      (font-lock-regexp-face :foreground ,orange-light)
      (font-lock-regexp-grouping-backslash :foreground ,orange-light)
      (font-lock-regexp-grouping-construct :foreground ,orange-light)
      (font-lock-negation-char-face :foreground ,red)
      (font-lock-operator-face :foreground ,gray8)
      (font-lock-punctuation-face :foreground ,gray8)
      (font-lock-bracket-face :foreground ,gray8)
      (font-lock-delimiter-face :foreground ,gray8)
      (font-lock-misc-punctuation-face :foreground ,orange-light)
      (font-lock-warning-face :foreground ,red :weight bold)

      ;; Headings (Org, Markdown, outline) ------------------------------------
      (outline-1 :foreground ,orange :weight bold)
      (outline-2 :foreground ,yellow :weight bold)
      (outline-3 :foreground ,green :weight bold)
      (outline-4 :foreground ,cyan :weight bold)
      (outline-5 :foreground ,blue :weight bold)
      (outline-6 :foreground ,magenta :weight bold)
      (outline-7 :foreground ,orange-light :weight bold)
      (outline-8 :foreground ,gray9 :weight bold)

      ;; Minibuffer completion (built in; vertico/orderless below) ------------
      (completions-common-part :foreground ,orange :weight bold)
      (completions-first-difference :foreground ,fg :weight bold)
      (completions-annotations :foreground ,gray6 :slant italic)
      (completions-highlight :foreground ,bg :background ,orange :weight bold)

      ;; Diagnostics: flymake / compilation -----------------------------------
      (flymake-error :underline (:style wave :color ,red))
      (flymake-warning :underline (:style wave :color ,yellow))
      (flymake-note :underline (:style wave :color ,cyan))
      (flymake-error-echo-at-eol :foreground ,red :background ,red-tint)
      (flymake-warning-echo-at-eol :foreground ,yellow :background ,orange-tint)
      (flymake-note-echo-at-eol :foreground ,cyan :background ,green-tint)
      (compilation-error :foreground ,red :weight bold)
      (compilation-warning :foreground ,yellow)
      (compilation-info :foreground ,green)
      (compilation-line-number :foreground ,gray6)
      (compilation-column-number :foreground ,gray6)
      (compilation-mode-line-fail :foreground ,red :weight bold)
      (compilation-mode-line-exit :foreground ,green :weight bold)

      ;; LSP (eglot) ----------------------------------------------------------
      (eglot-highlight-symbol-face :background ,gray2)
      (eglot-inlay-hint-face :foreground ,gray5 :background ,gray0 :slant italic :height 0.9)
      (eglot-mode-line :foreground ,orange)

      ;; Diff -----------------------------------------------------------------
      (diff-added :background ,green-tint :extend t)
      (diff-removed :foreground ,red :background ,red-tint :extend t)
      (diff-changed :background ,blue-tint :extend t)
      (diff-refine-added :foreground ,green-light :background ,green-tint :weight bold)
      (diff-refine-removed :foreground ,red-light :background ,red-tint :weight bold)
      (diff-refine-changed :background ,diff-text)
      (diff-indicator-added :foreground ,green)
      (diff-indicator-removed :foreground ,red)
      (diff-indicator-changed :foreground ,yellow)
      (diff-header :foreground ,gray9 :background ,gray1)
      (diff-file-header :foreground ,orange :background ,gray1 :weight bold)
      (diff-hunk-header :foreground ,blue :background ,gray1)
      (diff-context :foreground ,gray9)

      ;; Dired ----------------------------------------------------------------
      (dired-directory :foreground ,orange :weight bold)
      (dired-symlink :foreground ,cyan)
      (dired-header :foreground ,orange :weight bold)
      (dired-mark :foreground ,orange :weight bold)
      (dired-marked :foreground ,orange :weight bold)
      (dired-flagged :foreground ,red :weight bold)
      (dired-ignored :foreground ,gray5)
      (dired-perm-write :foreground ,gray7)
      (dired-special :foreground ,magenta)
      (dired-broken-symlink :foreground ,red :background ,red-tint)
      ;; diredfl (Doom's dired fontification): drop its default backgrounds
      ;; and mirror the marginalia file annotations in the minibuffer.
      (diredfl-dir-heading :foreground ,orange :weight bold)
      (diredfl-dir-name :foreground ,orange :weight bold)
      (diredfl-file-name :foreground ,fg)
      (diredfl-file-suffix :foreground ,gray7)
      (diredfl-compressed-file-name :foreground ,yellow)
      (diredfl-compressed-file-suffix :foreground ,yellow)
      (diredfl-symlink :foreground ,cyan)
      (diredfl-autofile-name :foreground ,blue)
      (diredfl-tagged-autofile-name :foreground ,blue-light)
      (diredfl-ignored-file-name :foreground ,gray5)
      (diredfl-executable-tag :foreground ,green)
      (diredfl-number :foreground ,magenta)
      (diredfl-date-time :foreground ,gray7)
      (diredfl-dir-priv :foreground ,orange :weight bold)
      (diredfl-link-priv :foreground ,cyan)
      (diredfl-read-priv :foreground ,yellow)
      (diredfl-write-priv :foreground ,red-light)
      (diredfl-exec-priv :foreground ,green)
      (diredfl-rare-priv :foreground ,magenta)
      (diredfl-other-priv :foreground ,magenta)
      (diredfl-no-priv :foreground ,gray4)
      (diredfl-flag-mark :foreground ,orange :weight bold)
      (diredfl-flag-mark-line :background ,orange-tint :extend t)
      (diredfl-deletion :foreground ,red :weight bold)
      (diredfl-deletion-file-name :foreground ,red :background ,red-tint)
      ;; dirvish (Doom's dired frontend)
      (dirvish-hl-line :background ,gray2 :extend t)
      (dirvish-hl-line-inactive :background ,gray1 :extend t)
      (dirvish-inactive :foreground ,gray5)
      (dirvish-subtree-state :foreground ,gray4)
      (dirvish-subtree-guide :foreground ,gray3)
      (dirvish-file-size :foreground ,magenta)
      (dirvish-file-time :foreground ,gray7)
      (dirvish-file-modes :foreground ,gray7)
      (dirvish-file-user-id :foreground ,orange-light)
      (dirvish-file-group-id :foreground ,orange-light)
      (dirvish-file-link-number :foreground ,gray6)
      (dirvish-file-inode-number :foreground ,gray6)
      (dirvish-file-device-number :foreground ,gray6)
      (dirvish-free-space :foreground ,gray7)
      (dirvish-collapse-dir-face :foreground ,orange)
      (dirvish-collapse-empty-dir-face :foreground ,gray5)
      (dirvish-collapse-file-face :foreground ,fg)
      (dirvish-emerge-group-title :foreground ,orange :weight bold)
      (dirvish-media-info-heading :foreground ,orange :weight bold)
      (dirvish-media-info-property-key :foreground ,blue-light :slant italic)
      (dirvish-git-commit-message-face :foreground ,gray6 :slant italic)
      (dirvish-narrow-match-face-0 :foreground ,orange :weight bold)
      (dirvish-narrow-match-face-1 :foreground ,yellow :weight bold)
      (dirvish-narrow-match-face-2 :foreground ,cyan :weight bold)
      (dirvish-narrow-match-face-3 :foreground ,magenta :weight bold)
      (dirvish-narrow-split :foreground ,gray5)
      (dirvish-vc-added-state :foreground ,green)
      (dirvish-vc-edited-state :foreground ,yellow)
      (dirvish-vc-removed-state :foreground ,red)
      (dirvish-vc-missing-state :foreground ,red)
      (dirvish-vc-conflict-state :foreground ,red :weight bold)
      (dirvish-vc-locked-state :foreground ,magenta)
      (dirvish-vc-needs-update-state :foreground ,blue)
      (dirvish-vc-needs-merge-face :background ,red-tint)
      (dirvish-vc-unregistered-face :foreground ,gray6)
      (dirvish-proc-running :foreground ,yellow)
      (dirvish-proc-finished :foreground ,green)
      (dirvish-proc-failed :foreground ,red :weight bold)

      ;; Terminal colors (vterm, eat, compilation): same 16 as foot -----------
      (ansi-color-black :foreground ,bg :background ,bg)
      (ansi-color-red :foreground ,red :background ,red)
      (ansi-color-green :foreground ,green :background ,green)
      (ansi-color-yellow :foreground ,orange :background ,orange)
      (ansi-color-blue :foreground ,blue :background ,blue)
      (ansi-color-magenta :foreground ,magenta :background ,magenta)
      (ansi-color-cyan :foreground ,cyan :background ,cyan)
      (ansi-color-white :foreground ,gray9 :background ,gray9)
      (ansi-color-bright-black :foreground ,gray3 :background ,gray3)
      (ansi-color-bright-red :foreground ,red-light :background ,red-light)
      (ansi-color-bright-green :foreground ,green-light :background ,green-light)
      (ansi-color-bright-yellow :foreground ,orange-light :background ,orange-light)
      (ansi-color-bright-blue :foreground ,blue-light :background ,blue-light)
      (ansi-color-bright-magenta :foreground ,magenta-light :background ,magenta-light)
      (ansi-color-bright-cyan :foreground ,cyan-light :background ,cyan-light)
      (ansi-color-bright-white :foreground ,fg :background ,fg)

      ;; which-key ------------------------------------------------------------
      (which-key-key-face :foreground ,orange :weight bold)
      (which-key-group-description-face :foreground ,blue)
      (which-key-command-description-face :foreground ,fg)
      (which-key-local-map-description-face :foreground ,fg)
      (which-key-separator-face :foreground ,gray5)
      (which-key-note-face :foreground ,gray6)

      ;; Doom modeline: evil state indicator, like the helix statusline ------
      (doom-modeline-evil-normal-state :foreground ,orange :weight bold)
      (doom-modeline-evil-insert-state :foreground ,green :weight bold)
      (doom-modeline-evil-visual-state :foreground ,magenta :weight bold)
      (doom-modeline-evil-replace-state :foreground ,red :weight bold)
      (doom-modeline-evil-motion-state :foreground ,blue :weight bold)
      (doom-modeline-evil-emacs-state :foreground ,cyan :weight bold)
      (doom-modeline-evil-operator-state :foreground ,yellow :weight bold)
      (doom-modeline-bar :background ,orange)
      (doom-modeline-bar-inactive :background ,gray0)
      (doom-modeline-buffer-file :foreground ,fg :weight bold)
      (doom-modeline-buffer-modified :foreground ,orange :weight bold)
      (doom-modeline-buffer-path :foreground ,gray7)
      (doom-modeline-project-dir :foreground ,blue :weight bold)
      (doom-modeline-info :foreground ,green)
      (doom-modeline-warning :foreground ,yellow)
      (doom-modeline-urgent :foreground ,red :weight bold)
      (doom-modeline-lsp-success :foreground ,green)
      ;; Doom dashboard
      (+dashboard-banner :foreground ,orange)
      (+dashboard-menu-title :foreground ,fg)
      (+dashboard-menu-desc :foreground ,gray7)
      (+dashboard-footer-icon :foreground ,orange)
      (+dashboard-loaded :foreground ,gray6)
      ;; evil
      (evil-ex-substitute-matches :foreground ,red :strike-through t)
      (evil-ex-substitute-replacement :foreground ,green :weight bold)
      (evil-ex-lazy-highlight :inherit lazy-highlight)
      (evil-ex-info :foreground ,red :slant italic)
      ;; lsp-mode / lsp-ui (Doom's default LSP client)
      (lsp-face-highlight-textual :background ,gray2)
      (lsp-face-highlight-read :background ,gray2)
      (lsp-face-highlight-write :background ,gray2 :underline t)
      (lsp-inlay-hint-face :foreground ,gray5 :background ,gray0 :slant italic)
      (lsp-headerline-breadcrumb-path-face :foreground ,gray7)
      (lsp-headerline-breadcrumb-symbols-face :foreground ,yellow)
      (lsp-headerline-breadcrumb-separator-face :foreground ,gray5)
      (lsp-ui-doc-background :background ,gray1)
      (lsp-ui-peek-peek :background ,gray1)
      (lsp-ui-peek-list :background ,gray0)
      (lsp-ui-peek-selection :foreground ,bg :background ,orange)
      (lsp-ui-peek-highlight :foreground ,orange :weight bold)
      (lsp-ui-sideline-code-action :foreground ,yellow)
      ;; flycheck (Doom's default checker)
      (flycheck-error :underline (:style wave :color ,red))
      (flycheck-warning :underline (:style wave :color ,yellow))
      (flycheck-info :underline (:style wave :color ,cyan))
      (flycheck-fringe-error :foreground ,red)
      (flycheck-fringe-warning :foreground ,yellow)
      (flycheck-fringe-info :foreground ,cyan)
      (flycheck-posframe-background-face :background ,gray1)
      ;; treemacs / projectile / workspaces
      (+workspace-tab-selected-face :foreground ,bg :background ,orange :weight bold)
      (+workspace-tab-face :foreground ,gray7)
      (treemacs-root-face :foreground ,orange :weight bold)
      (treemacs-directory-face :foreground ,blue)
      (treemacs-file-face :foreground ,fg)
      (treemacs-git-modified-face :foreground ,yellow)
      (treemacs-git-added-face :foreground ,green)
      (treemacs-git-untracked-face :foreground ,blue)
      (vi-tilde-fringe-face :foreground ,gray3)
      (solaire-default-face :inherit default)
      (solaire-hl-line-face :inherit hl-line)

      ;; Completion, git and navigation packages ------------------------------
      ;; vertico / orderless / marginalia / consult
      (vertico-current :foreground ,fg :background ,gray2 :weight bold :extend t)
      (orderless-match-face-0 :foreground ,orange :weight bold)
      (orderless-match-face-1 :foreground ,yellow :weight bold)
      (orderless-match-face-2 :foreground ,cyan :weight bold)
      (orderless-match-face-3 :foreground ,magenta :weight bold)
      (marginalia-documentation :foreground ,gray6 :slant italic)
      (nerd-icons-completion-dir-face :foreground ,orange)
      (consult-file :foreground ,fg)
      (consult-preview-line :background ,gray1 :extend t)
      ;; corfu (in-buffer completion popup, like blink.cmp's Pmenu)
      (corfu-default :foreground ,fg :background ,gray1)
      (corfu-current :foreground ,bg :background ,orange :weight bold)
      (corfu-border :background ,gray4)
      (corfu-bar :background ,gray4)
      (corfu-annotations :foreground ,gray6)
      ;; diff-hl (gitsigns)
      (diff-hl-insert :foreground ,green :background ,green)
      (diff-hl-change :foreground ,yellow :background ,yellow)
      (diff-hl-delete :foreground ,red :background ,red)
      ;; avy (flash.nvim)
      (avy-background-face :foreground ,gray5)
      (avy-lead-face :foreground ,bg :background ,orange :weight bold)
      (avy-lead-face-0 :foreground ,bg :background ,yellow :weight bold)
      (avy-lead-face-1 :foreground ,bg :background ,cyan :weight bold)
      (avy-lead-face-2 :foreground ,bg :background ,magenta :weight bold)
      ;; magit
      (magit-section-heading :foreground ,orange :weight bold)
      (magit-section-highlight :background ,gray1 :extend t)
      (magit-branch-local :foreground ,blue)
      (magit-branch-remote :foreground ,green)
      (magit-branch-current :foreground ,blue :weight bold :box (:line-width -1 :color ,blue))
      (magit-hash :foreground ,gray6)
      (magit-tag :foreground ,yellow)
      (magit-dimmed :foreground ,gray5)
      (magit-filename :foreground ,fg)
      (magit-diff-file-heading :foreground ,fg :weight bold)
      (magit-diff-file-heading-highlight :foreground ,fg :background ,gray1 :weight bold)
      (magit-diff-hunk-heading :foreground ,gray7 :background ,gray1 :extend t)
      (magit-diff-hunk-heading-highlight :foreground ,fg :background ,gray2 :extend t)
      (magit-diff-context :foreground ,gray6 :extend t)
      (magit-diff-context-highlight :foreground ,gray9 :background ,gray0 :extend t)
      (magit-diff-added :foreground ,green :background ,green-tint :extend t)
      (magit-diff-added-highlight :foreground ,green-light :background ,green-tint :extend t)
      (magit-diff-removed :foreground ,red :background ,red-tint :extend t)
      (magit-diff-removed-highlight :foreground ,red-light :background ,red-tint :extend t)
      (magit-diffstat-added :foreground ,green)
      (magit-diffstat-removed :foreground ,red)
      (magit-log-author :foreground ,orange-light)
      (magit-log-date :foreground ,gray6)
      (magit-process-ok :foreground ,green :weight bold)
      (magit-process-ng :foreground ,red :weight bold)))))

;;;###autoload
(when load-file-name
  (add-to-list 'custom-theme-load-path
               (file-name-as-directory (file-name-directory load-file-name))))

(provide-theme 'caelus)
;;; caelus-theme.el ends here
