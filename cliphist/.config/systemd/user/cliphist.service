# Clipboard history for Noctalia's clipboard panel (text and images).
#   systemctl --user enable cliphist.service cliphist-images.service
[Unit]
Description=Clipboard management daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --watch /usr/bin/cliphist -max-dedupe-search 10 -max-items 500 store
Restart=on-failure

[Install]
WantedBy=graphical-session.target
