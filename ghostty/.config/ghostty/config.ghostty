# Ghostty: the terminal for when I'm not in Emacs. Mango owns window
# layout, Emacs owns development shells (ghostel); Ghostty adds tabs, the odd
# split and a keyboard path to URLs. tmux is only for remote persistence.
#
# Reference: `ghostty +show-config --default --docs`, `ghostty +list-actions
# --docs`, `ghostty +list-keybinds` (effective binds). Check this file with
# `ghostty +validate-config`; reload with ctrl+shift+, (Mango's SUPER+Return
# talks to a resident instance over D-Bus, see below).

# ---- Look ------------------------------------------------------------------
theme = caelus

font-family = Iosevka Term
font-size = 16

window-padding-x = 7
window-padding-y = 2
window-padding-balance = true

cursor-style = block
cursor-style-blink = true

# Mango tiles: no titlebar or CSD borders. The tab bar still shows up once
# there are two or more tabs.
window-decoration = none
gtk-toolbar-style = flat
# The "120x40" size overlay pops up on every tiling change otherwise.
resize-overlay = never

mouse-hide-while-typing = true

# ---- Behaviour --------------------------------------------------------------
# Keep running after the last window closes (a resident server),
# so new windows open instantly. The first SUPER+Return of a session
# D-Bus-activates app-com.mitchellh.ghostty.service.
quit-after-last-window-closed = false

# Close windows, tabs and splits right away, even with something running in
# them (no "process is still running" dialog).
confirm-close-surface = false

# New windows (SUPER+Return) start in ~; tabs and splits follow the current
# directory (what tmux's `-c '#{pane_current_path}'` binds did).
# `home` also overrides the caller's cwd: launchers that rely on it (Dolphin's
# "Open Terminal Here", `ghostty` run from a shell) must pass
# --working-directory=inherit (or a path) to keep it.
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

# Bytes, not lines (per terminal, allocated lazily): ~50 MB is tens of
# thousands of lines. Long output belongs in Emacs anyway (ctrl+shift+s).
scrollback-limit = 50000000

# Shell integration (zsh, auto-detected):
#   no-cursor     zshrc already shapes the cursor per vi mode
#   sudo          keep Ghostty's terminfo under sudo
#   ssh-env       TERM falls back to xterm-256color on hosts without terminfo
#   ssh-terminfo  install xterm-ghostty on remote hosts on first ssh
#                 (cache: `ghostty +ssh-cache`)
# It also marks prompts (OSC 133): jump between prompts, click to move the
# cursor in the prompt, command-finished notifications below.
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# Desktop notification (Noctalia) + bell (urgency, 🔔 in the tab title) when
# a command that ran 20s+ finishes while its terminal isn't focused.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 20s

# ---- Keybinds ---------------------------------------------------------------
# All chords, no prefix: ctrl+a stays free for tmux on the servers. Plain
# letters only (no punctuation) so they survive layout changes.

# Copy as plain text (the default "mixed" also puts HTML with the terminal's
# colors on the clipboard, which rich-text fields paste). ctrl+insert is what
# Mango's SUPER+C sends.
keybind = ctrl+shift+c=copy_to_clipboard:plain
keybind = ctrl+insert=copy_to_clipboard:plain
keybind = copy=copy_to_clipboard:plain

# Tabs. Defaults kept: ctrl+shift+t new, ctrl+tab / ctrl+shift+tab cycle,
# alt+1..8 go to, alt+9 last.
keybind = ctrl+shift+page_up=move_tab:-1
keybind = ctrl+shift+page_down=move_tab:1
keybind = ctrl+shift+r=prompt_tab_title

# Splits: ctrl+shift + Mango's verbs (Mango: SUPER+hjkl focus, SUPER+ALT+hjkl
# resize). Enter splits along the longer side, like Mango's dwindle.
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+alt+shift+h=resize_split:left,40
keybind = ctrl+alt+shift+j=resize_split:down,40
keybind = ctrl+alt+shift+k=resize_split:up,40
keybind = ctrl+alt+shift+l=resize_split:right,40
keybind = ctrl+alt+shift+e=equalize_splits

# Close the focused split (or the tab/window when it's the last one).
keybind = ctrl+shift+w=close_surface

# Scrollback. Defaults kept: ctrl+shift+f search (enter / shift+enter next /
# previous, escape closes), shift+page_up/down and shift+home/end scroll.
keybind = ctrl+shift+arrow_up=jump_to_prompt:-1
keybind = ctrl+shift+arrow_down=jump_to_prompt:1

# Hand text to Emacs in a new frame (xdg-open; text/plain is
# emacsclient-frame.desktop in the mimeapps package):
#   ctrl+shift+o  visible screen: pick a URL with SPC s l (hints) or SPC s L
#                 (list).
#   ctrl+shift+s  the whole scrollback: search, copy, grep it as a buffer.
keybind = ctrl+shift+o=write_screen_file:open,plain
keybind = ctrl+shift+s=write_scrollback_file:open,plain
